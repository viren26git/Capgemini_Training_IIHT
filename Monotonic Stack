package capg.demos;

public class MonotnicDemo {
	public static void main(String[] args) {
		
		int[] arr = {2,1,5,3};
		
		int n = arr.length;
		
		int[] result = new int[n];
		
		int[] stack = new int[n];
		
		int top =-1;
		
		for(int i = n-1; i>=0; i--) {
			
			//remove elements that are smaller than or equal to current
			while(top !=-1 && stack[top] <= arr[i])
			{
				top-- ;
			}
			
			// if stack is empty then no greater element exists
			if(top == -1) {
				result[i] = -1;
			}
			else {
				result[i] = stack[top];
			}
			
			// push current element into the stack
			top++;
			stack[top] = arr[i];
		}
		
		System.out.println(" The result is :" );
		
		for (int i = 0; i< n; i++)
		System.out.println(result[i] + " ");

	}
}
